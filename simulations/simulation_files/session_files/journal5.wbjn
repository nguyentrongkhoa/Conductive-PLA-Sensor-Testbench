Save(Overwrite=True)
parameter1 = Parameters.CreateParameter(
    IsOutput=True,
    Expression="(P20-P19)/P19",
    DisplayText="Output Parameter")
parameter1.DisplayText = "Change in Resistance"
Save(Overwrite=True)
