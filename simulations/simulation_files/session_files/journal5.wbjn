# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SC")
system1.Delete()
system2 = GetSystem(Name="SYS")
model1 = system2.GetContainer(ComponentName="Model")
model1.Edit()
Save(Overwrite=True)
template1 = GetTemplate(TemplateName="Direct Optimization")
system3 = template1.CreateSystem()
Save(Overwrite=True)
parameter1 = Parameters.CreateParameter(
    IsOutput=True,
    Expression="(P20-P19)/P19",
    DisplayText="Output Parameter")
parameter1.DisplayText = "Change in Resistance"
Save(Overwrite=True)
optimizationComponent1 = system3.GetComponent(Name="Optimization")
optimizationComponent1.Refresh()
optimization1 = system3.GetContainer(ComponentName="Optimization")
optimizationModel1 = optimization1.GetModel()
outputParameter1 = optimizationModel1.GetParameter(Name="P21")
optimizationCriterion1 = outputParameter1.CreateOptimizationCriterion()
optimizationCriterion1.ObjectiveType = "GT_MaximumPossible"
optimizationCriterion1.ConstraintType = "CT_LessThanTarget"
optimizationCriterion1.ConstraintFirstValue = 0.008
optimizationCriterion1.ObjectiveTargetValue = 0
optimizationCriterion1.ObjectiveTargetValue = 0.008
optimizationCriterion1.DisplayText = "Maximize Sensitivity"
Save(Overwrite=True)
outputParameter2 = optimizationModel1.GetParameter(Name="P20")
optimizationCriterion2 = outputParameter2.CreateOptimizationCriterion()
optimizationCriterion2.ObjectiveType = "GT_SeekTarget"
optimizationCriterion2.ObjectiveTargetValue = 100000
optimizationCriterion2.TargetTolerance = 0.05
optimizationCriterion1.FeasibleTolerance = 0.002
optimizationCriterion2.TargetTolerance = 5000
parameterRelationship1 = optimizationModel1.CreateParameterRelationship(LeftExpression="P2")
parameterRelationship1.RightExpression = "P3"
inputParameter1 = optimizationModel1.GetParameter(Name="P10")
optimizationCriterion3 = inputParameter1.GetOptimizationCriterion()
optimizationCriterion3.LowerBound = 0.15
optimizationCriterion3.UpperBound = 0.3
inputParameter2 = optimizationModel1.GetParameter(Name="P11")
optimizationCriterion4 = inputParameter2.GetOptimizationCriterion()
optimizationCriterion4.LowerBound = 15
optimizationCriterion4.LowerBound = 10
optimizationCriterion4.UpperBound = 30
Save(Overwrite=True)
optimizationModel1.MethodSelection = "OMS_Manual"
optimizationModel1.MethodName = "ANSYS_SCREENING"
Save(Overwrite=True)
screeningOptimization1 = optimizationModel1.Method
screeningOptimization1.MaxNumCandidates = 5
screeningOptimization1.NumberOfSamples = 100
Save(Overwrite=True)
inputParameter3 = optimizationModel1.GetParameter(Name="P1")
optimizationCriterion5 = inputParameter3.GetOptimizationCriterion()
optimizationCriterion5.LowerBound = 15
optimizationCriterion5.UpperBound = 50
parameterRelationship2 = optimizationModel1.CreateParameterRelationship(LeftExpression="P2")
parameterRelationship2.RelationshipType = "PRT_GreaterThanOrEqualTo"
parameterRelationship2.RightExpression = "P6"
parameterRelationship2.DisplayText = "Steel plate has to be wider than substrate"
model1.Exit()
inputParameter4 = optimizationModel1.GetParameter(Name="P3")
inputParameter4.Enabled = False
inputParameter1.Enabled = False
Save(Overwrite=True)
