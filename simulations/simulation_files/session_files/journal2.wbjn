# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS 1")
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
favorites1 = EngData.LoadFavoriteItems()
library1 = EngData.OpenLibrary(
    Name="Additive Manufacturing Materials",
    Source="Additive_Manufacturing_Materials.xml")
material1 = library1.GetMaterial(Name="PLA")
matlProp1 = material1.GetProperty(Name="Resistivity")
matlProp1.SetData(
    Variables=["Resistivity"],
    Values=[["1E+30 [ohm m]"]])
library1.Save()
library1.Save()
Refresh()
Refresh()
system2 = GetSystem(Name="SYS")
engineeringData1 = system2.GetContainer(ComponentName="Engineering Data")
material2 = engineeringData1.GetMaterial(Name="PLA")
material2.Refresh(Source="Additive_Manufacturing_Materials.xml")
Refresh()
matlProp1.SetData(
    Variables=["Resistivity"],
    Values=[["1000000000 [ohm m]"]])
library1.Save()
material2.Refresh(Source="Additive_Manufacturing_Materials.xml")
Refresh()
Save(Overwrite=True)
model1.Exit()
model2 = system2.GetContainer(ComponentName="Model")
model2.Edit()
Save(Overwrite=True)
Save(Overwrite=True)
Save(Overwrite=True)
template1 = GetTemplate(TemplateName="System Coupling")
system3 = template1.CreateSystem(
    Position="Right",
    RelativeTo=system1)
setup1 = system3.GetContainer(ComponentName="Setup")
AnalysisSettings1 = setup1.GetAnalysisSettings()
AnalysisSettings1.MinimumIteration = 3
AnalysisSettings1.MaximumIteration = 10
Save(Overwrite=True)
setupComponent1 = system2.GetComponent(Name="Setup")
setupComponent2 = system3.GetComponent(Name="Setup")
setupComponent1.TransferData(TargetComponent=setupComponent2)
setupComponent2.Refresh()
setupComponent1.DeleteTransfer(TargetComponent=setupComponent2)
Save(Overwrite=True)
model2.Exit()
Save(Overwrite=True)
