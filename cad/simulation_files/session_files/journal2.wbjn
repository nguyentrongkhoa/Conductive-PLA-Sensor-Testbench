# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS 1")
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
Save(Overwrite=True)
model1.Exit()
model1.Edit()
Save(Overwrite=True)
model1.Exit()
template1 = GetTemplate(
    TemplateName="Static Mechanical",
    Solver="ANSYS")
system2 = template1.CreateSystem(
    Position="Right",
    RelativeTo=system1)
favorites1 = EngData.LoadFavoriteItems()
library1 = EngData.OpenLibrary(
    Name="Additive Manufacturing Materials",
    Source="Additive_Manufacturing_Materials.xml")
engineeringData1 = system2.GetContainer(ComponentName="Engineering Data")
matl1 = engineeringData1.ImportMaterial(
    Name="PLA",
    Source="Additive_Manufacturing_Materials.xml")
matl2 = engineeringData1.ImportMaterial(
    Name="Protopasta cPLA",
    Source="Additive_Manufacturing_Materials.xml")
geometry1 = system2.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath="C:/Users/khoa1/OneDrive/Desktop/Studium/Mechatronik/2. Sem/Forschungsprojekt/cad/fp_100_sensor_asm.stp")
Save(Overwrite=True)
modelComponent1 = system2.GetComponent(Name="Model")
modelComponent1.Refresh()
model2 = system2.GetContainer(ComponentName="Model")
model2.Edit()
Save(Overwrite=True)
Save(Overwrite=True)
Save(Overwrite=True)
model2.Exit()
model2.Edit()
material1 = library1.GetMaterial(Name="PLA")
matlProp1 = material1.CreateProperty(
    Name="Thermal Conductivity",
    Behavior="Isotropic",
    Qualifiers={"Definition": "", "Behavior": "Isotropic"})
matlProp1.SetData(
    Index=-1,
    Variables=["Thermal Conductivity"],
    Values=[["0.136 [W m^-1 C^-1]"]])
material2 = library1.GetMaterial(Name="Protopasta cPLA")
matlProp2 = material2.CreateProperty(
    Name="Thermal Conductivity",
    Behavior="Isotropic",
    Qualifiers={"Definition": "", "Behavior": "Isotropic"})
matlProp2.SetData(
    Index=-1,
    Variables=["Thermal Conductivity"],
    Values=[["0.136 [W m^-1 C^-1]"]])
library1.Save()
library1.Save()
matl2.Refresh(Source="Additive_Manufacturing_Materials.xml")
matl1.Refresh(Source="Additive_Manufacturing_Materials.xml")
Refresh()
Save(Overwrite=True)
geometry1.Edit(IsDiscoveryGeometry=True)
geometry1.Edit(IsSpaceClaimGeometry=True)
geometryProperties1 = geometry1.GetGeometryProperties()
geometryProperties1.GeometryImportLineBodies = True
geometryProperties1.GeometryImportParameters = "CADImportParameterType_All"
geometryProperties1.GeometryImportParametersFilter = ""
geometryProperties1.GeometryImportCadAttributes = True
geometryProperties1.GeometryImportCadAttributes = False
geometryProperties1.GeometryImportParameters = "CADImportParameterType_Independent"
geometry1.Edit(IsDiscoveryGeometry=True)
model2.Exit()
geometry1.Edit(IsDiscoveryGeometry=True)
system1.Delete()
geometry1.Edit(IsDiscoveryGeometry=True)
geometry1.Edit(IsDiscoveryGeometry=True)
geometry1.Exit()
modelComponent1.Refresh()
model2.Edit()
Save(Overwrite=True)
