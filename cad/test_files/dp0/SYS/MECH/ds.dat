toffst,273.15,      ! Temperature offset from absolute zero
/com,*********** Set Reference Temperature ***********
tref,22.
/wb,mat,start              !  starting to send materials
/com,*********** Send Materials ***********
MP,DENS,1,1150,	! kg m^-3
MP,EX,1,32000000,	! Pa
MP,NUXY,1,0.4,
MP,RSVX,1,0.3,	! kg m^3 A^-2 s^-3
MP,RSVY,1,0.3,	! kg m^3 A^-2 s^-3
