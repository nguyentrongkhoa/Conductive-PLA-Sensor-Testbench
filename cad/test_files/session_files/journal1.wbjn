# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
DesignModeler.CreateGeometrySystemWithActiveCAD(
    FilePath=r"C:\Users\khoa1\OneDrive\Desktop\Studium\Mechatronik\2. Sem\Forschungsprojekt\cad\FP_100_SENSOR_ASM.ASM",
    PlugInName="ProEngineer[34968]")
system1 = GetSystem(Name="Geometry")
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometryProperties1 = geometry1.GetGeometryProperties()
geometryProperties1.GeometryImportParameters = "CADImportParameterType_All"
geometryProperties1.GeometryImportParametersFilter = ""
geometry1.Edit(IsDiscoveryGeometry=True)
designPoint1 = Parameters.CreateDesignPoint()
parameter1 = Parameters.GetParameter(Name="P12")
designPoint1.SetParameterExpression(
    Parameter=parameter1,
    Expression="10")
backgroundSession1 = UpdateAllDesignPoints(DesignPoints=[designPoint1])
designPoint2 = Parameters.GetDesignPoint(Name="0")
designPoint1.CopyParameterExpressions(ToDesignPoint=designPoint2)
designPoint2.SetParameterExpression(
    Parameter=parameter1,
    Expression="8")
designPoint1.Retained = True
Parameters.SetBaseDesignPoint(DesignPoint=designPoint1)
Refresh()
designPoint1.SetParameterExpression(
    Parameter=parameter1,
    Expression="10")
geometry1.Edit(IsDiscoveryGeometry=True)
geometry1.Refresh()
geometry1.Exit()
designPoint3 = Parameters.CreateDesignPoint()
parameter2 = Parameters.GetParameter(Name="P6")
designPoint3.SetParameterExpression(
    Parameter=parameter2,
    Expression="20")
designPoint3.Retained = True
Parameters.SetBaseDesignPoint(DesignPoint=designPoint3)
geometry1.Edit(IsDiscoveryGeometry=True)
geometry1.Refresh()
geometry1.Exit()
Save(Overwrite=True)
